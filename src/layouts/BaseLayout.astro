---
import "../styles/global.css";
import "@hixbe/kalpurush/400.css";

const {
  title = "এপিটাফ — Epitaph",
  description = "Writings by Prankrishna Borgohain",
  canonical,
  image = "/epitaph/og-default.svg"
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://thediffigral.github.io/epitaph");
const canonicalUrl = canonical ? new URL(canonical.replace(/^\/+/, ""), siteUrl.href.endsWith("/") ? siteUrl.href : siteUrl.href + "/").href : Astro.url.href;
const imageUrl = new URL(image, siteUrl).href;
---
<!doctype html>
<html lang="as">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4355b9" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="এপিটাফ — Epitaph" href={new URL("rss.xml", siteUrl)} />
    <link rel="sitemap" href={new URL("sitemap-index.xml", siteUrl)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="এপিটাফ — Epitaph" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={import.meta.env.BASE_URL}>এপিটাফ · Epitaph</a>
        <nav class="nav" aria-label="Primary">
          <a href={import.meta.env.BASE_URL}>Home</a>
          <a href={import.meta.env.BASE_URL + "archive/"}>Archive</a>
          <a href="https://thediffigral.github.io/prankrishna-borgohain/">My website</a>
          <button class="icon-button" id="theme-toggle" type="button" aria-label="Toggle theme" aria-pressed="false">◐</button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script data-goatcounter="https://thediffigral.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <script>
      const root = document.documentElement;
      const button = document.getElementById("theme-toggle");
      const saved = localStorage.getItem("theme");
      const preferred = saved ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      root.dataset.theme = preferred;
      button?.setAttribute("aria-pressed", String(preferred === "dark"));
      button?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
        button?.setAttribute("aria-pressed", String(next === "dark"));
      });
    </script>
  </body>
</html>
