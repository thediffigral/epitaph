---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allPosts } from "../lib/content";
---
<BaseLayout title="Archive — Epitaph">
  <section class="page">
    <div class="container">
      <p class="eyebrow">Archive</p>
      <h1 class="article-title">All writings</h1>
      <div class="post-grid">
        {allPosts.map((post) => (
          <article class="post-card">
            <p class="meta">{new Date(post.published).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</p>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <a class="read-more" href={import.meta.env.BASE_URL + "post/" + post.id + "/"}>Read →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>