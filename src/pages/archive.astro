---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allPosts, getPostPath } from "../lib/content";
const labels = [...new Set(allPosts.flatMap((post) => post.labels))].filter(Boolean).sort((a,b) => a.localeCompare(b));
---

<BaseLayout title="Archive — Epitaph" description="Browse the complete archive of writings by Prankrishna Borgohain.">
  <section class="page archive-page">
    <div class="container">
      <div class="archive-header">
        <div>
          <p class="eyebrow">Archive</p>
          <h1 class="article-title">All writings</h1>
          <p class="lede">{allPosts.length} writings, collected in one place.</p>
        </div>
      </div>

      <div class="archive-tools">
        <label class="search-box">
          <span>Search writings</span>
          <input id="post-search" type="search" placeholder="Search by title or text…" autocomplete="off" />
        </label>
        <label class="filter-box">
          <span>Topic</span>
          <select id="tag-filter">
            <option value="">All topics</option>
            {labels.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </label>
      </div>

      <p id="search-status" class="search-status" aria-live="polite"></p>

      <div class="archive-grid" id="archive-grid">
        {allPosts.map((post) => (
          <article class="archive-card" data-search={(post.title + " " + post.excerpt + " " + post.labels.join(" ")).toLowerCase()} data-tags={JSON.stringify(post.labels.map((label) => label.trim().toLocaleLowerCase()))}>
            <div class="archive-card-top">
              <p class="meta"><time datetime={post.published}>{new Date(post.published).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</time></p>
              {post.labels[0] && <span class="archive-label">{post.labels[0]}</span>}
            </div>
            <h2><a href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>{post.title}</a></h2>
            <p>{post.excerpt}</p>
            <div class="archive-card-footer">
              <div class="tags">{post.labels.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div>
              <a class="read-more" href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>Read →</a>
            </div>
          </article>
        ))}
      </div>

      <p id="no-results" class="no-results" hidden>No writings match your search.</p>
    </div>
  </section>

  <script>
    const search = document.querySelector("#post-search") as HTMLInputElement | null;
    const filter = document.querySelector("#tag-filter") as HTMLSelectElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".archive-card"));
    const status = document.querySelector("#search-status") as HTMLElement | null;
    const empty = document.querySelector("#no-results") as HTMLElement | null;
    const params = new URLSearchParams(window.location.search);
    const initialTag = params.get("tag") || "";

    if (initialTag && filter) {
      const normalizedInitialTag = initialTag.trim().normalize("NFC").toLocaleLowerCase();
      const matchingOption = Array.from(filter.options).find((option) => option.value.trim().normalize("NFC").toLocaleLowerCase() === normalizedInitialTag);
      if (matchingOption) filter.value = matchingOption.value;
    }

    const apply = () => {
      const query = (search?.value || "").trim().toLowerCase();
      const tag = (filter?.value || "").trim().normalize("NFC").toLocaleLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesQuery = !query || (card.dataset.search || "").includes(query);
        const tags = JSON.parse(card.dataset.tags || "[]") as string[];
        const matchesTag = !tag || tags.some((item) => item.normalize("NFC").trim().toLocaleLowerCase() === tag);
        const show = matchesQuery && matchesTag;
        card.hidden = !show;
        if (show) visible++;
      });

      if (status) status.textContent = visible + " " + (visible === 1 ? "writing" : "writings") + " shown";
      if (empty) empty.hidden = visible !== 0;

      const next = new URL(window.location.href);
      if (tag) next.searchParams.set("tag", tag);
      else next.searchParams.delete("tag");
      if (history.replaceState) history.replaceState(null, "", next);
    };

    if (search) search.addEventListener("input", apply);
    if (filter) filter.addEventListener("change", apply);
    apply();
  </script>
</BaseLayout>
