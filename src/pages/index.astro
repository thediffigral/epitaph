---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allPosts, getPostPath, getPostImage } from "../lib/content";

const latest = allPosts[0];
const labels = [...new Set(allPosts.flatMap((post) => post.labels))].filter(Boolean).slice(0, 12);
const postsByLabel = (label: string) => allPosts.filter((post) => post.labels.includes(label));
const findLabel = (needle: string, fallbackIndex: number) =>
  labels.find((label) => label.toLocaleLowerCase().includes(needle.toLocaleLowerCase())) ?? labels[fallbackIndex] ?? "";
const guestLabel = findLabel("guest author", 0);
const clockLabel = findLabel("travelling clock", 1);
const movieLabel = labels.find((label) => label.toLocaleLowerCase() === "movie") ?? "";
---

<BaseLayout title="এপিটাফ — Epitaph" description="Prankrishna Borgohain's writings. Essays, notes and reflections.">
  <main>
    {latest && (
      <section class:list={["feature", "container", { "feature-with-image": getPostImage(latest) }]} style={getPostImage(latest) ? "background-image: url('" + getPostImage(latest) + "')" : undefined}>
        <div class="feature-overlay" aria-hidden="true"></div>
        <div class="feature-copy">
          <p class="eyebrow">Featured · Latest</p>
          <p class="feature-date">
            <time datetime={latest.published}>
              {new Date(latest.published).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </p>
          <h1>{latest.title}</h1>
          <p class="feature-excerpt">{latest.excerpt}</p>
          <a class="feature-link" href={import.meta.env.BASE_URL + getPostPath(latest) + "/"}>Read more <span>→</span></a>
        </div>
        <div class="feature-rule" aria-hidden="true"></div>
      </section>
    )}

    <section class="container fiction-feature" aria-labelledby="fiction-title">
      <div class="section-heading fiction-heading">
        <div>
          <p class="eyebrow">Fiction</p>
          <h2 id="fiction-title">Four stories</h2>
        </div>
        <span class="fiction-note">Selected from the archive</span>
      </div>
      <div class="fiction-grid">
        {[
          "https://prankrishnab.blogspot.com/2022/10/blog-post.html",
          "https://prankrishnab.blogspot.com/2017/11/porisoy.html",
          "https://prankrishnab.blogspot.com/2017/11/protiddhwoni.html",
          "https://prankrishnab.blogspot.com/2013/11/blog-post.html"
        ].map((url, index) => {
          const post = allPosts.find((item) => item.url === url || item.url.replace(/\/$/, "") === url.replace(/\/$/, ""));
          return post ? (
            <article class:list={["fiction-card", { "fiction-card-featured": index === 0 }]}>
              {getPostImage(post) ? (
                <a class="fiction-image" href={import.meta.env.BASE_URL + getPostPath(post) + "/"} aria-label={"Read " + post.title}>
                  <img src={getPostImage(post)} alt="" loading="lazy" />
                </a>
              ) : (
                <a class="fiction-image fiction-image-fallback" href={import.meta.env.BASE_URL + getPostPath(post) + "/"} aria-label={"Read " + post.title}></a>
              )}
              <div class="fiction-card-body">
                <p class="story-meta">Fiction · 0{index + 1}</p>
                <h3><a href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
                <a class="fiction-read" href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>Read story <span>↗</span></a>
              </div>
            </article>
          ) : null;
        })}
      </div>
    </section>

    {labels.length > 0 && (
      <section class="container browse-section" aria-labelledby="browse-title">
        <div class="browse-heading">
          <div>
            <p id="browse-title" class="eyebrow">Explore</p>
          </div>

        </div>

        <div class="label-tabs-wrap">
          <button class="label-scroll label-scroll-left" type="button" aria-label="Show previous labels" data-label-scroll="-1">‹</button>
          <div class="label-tabs" role="tablist" aria-label="Writing labels">
          {labels.map((label, index) => (
            <button
              type="button"
              class:list={["label-tab", { active: index === 0 }]}
              role="tab"
              aria-selected={index === 0}
              aria-controls={"label-panel-" + index}
              data-label-tab={label}
              data-label-index={index}
            >
              {label}
            </button>
          ))}
          </div>
          <button class="label-scroll label-scroll-right" type="button" aria-label="Show more labels" data-label-scroll="1">›</button>
        </div>

        <div class="label-panels">
          {labels.map((label, index) => (
            <div
              id={"label-panel-" + index}
              class:list={["label-panel", { active: index === 0 }]}
              role="tabpanel"
              aria-label={label}
              data-label-panel={label}
              hidden={index !== 0}
            >
              <div class="label-showcase story-list">
                {postsByLabel(label).slice(0, 3).map((post, postIndex) => (
                  <article class="story-row">
                    <span class="story-number">{String(postIndex + 1).padStart(2, "0")}</span>
                    {getPostImage(post) ? <div class="story-thumb"><img src={getPostImage(post)} alt="" loading="lazy" /></div> : <div class="story-thumb story-thumb-fallback" aria-hidden="true"></div>}
                    <div class="story-main">
                      <p class="story-meta">{label}</p>
                      <h3><a href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>{post.title}</a></h3>
                      <p>{post.excerpt}</p>
                    </div>
                    <a class="story-arrow" href={import.meta.env.BASE_URL + getPostPath(post) + "/"} aria-label={"Read " + post.title}>↗</a>
                  </article>
                ))}
              </div>
              <a class="more-label" href={import.meta.env.BASE_URL + "archive/?tag=" + encodeURIComponent(label)}>
                More from {label} <span>→</span>
              </a>
            </div>
          ))}
        </div>

        {clockLabel && (
          <section class="home-section nowhere-section" aria-labelledby="nowhere-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Another corner</p>
                <h2 id="nowhere-title">Nowhere to go</h2>
              </div>
              <a class="archive-link" href={import.meta.env.BASE_URL + "archive/?tag=" + encodeURIComponent(clockLabel)}>More →</a>
            </div>
            <div class="nowhere-list">
              {postsByLabel(clockLabel).slice(0, 3).map((post) => (
                <article class="nowhere-story">
                  <div class="nowhere-copy">
                    <p class="story-meta">{clockLabel}</p>
                    <h3><a href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>{post.title}</a></h3>
                    <p>{post.excerpt}</p>
                    <a class="more-label" href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>Read article →</a>
                  </div>
                  {getPostImage(post) ? (
                    <a class="nowhere-image" href={import.meta.env.BASE_URL + getPostPath(post) + "/"} aria-label={"Read " + post.title}>
                      <img src={getPostImage(post)} alt="" loading="lazy" />
                    </a>
                  ) : <div class="nowhere-image nowhere-fallback" aria-hidden="true"></div>}
                </article>
              ))}
            </div>
          </section>
        )}

        {movieLabel && (
          <section class="home-section movie-section" aria-labelledby="movie-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">From the label</p>
                <h2 id="movie-title">dynamical frame</h2>
              </div>
              <a class="archive-link" href={import.meta.env.BASE_URL + "archive/?tag=" + encodeURIComponent(movieLabel)}>More →</a>
            </div>
            <div class="showcase-grid movie-showcase">
              {postsByLabel(movieLabel).slice(0, 3).map((post, index) => (
                <article class:list={["showcase-card", { "showcase-card-large": index === 0 }]}>
                  {getPostImage(post) ? (
                    <img src={getPostImage(post)} alt="" loading="lazy" />
                  ) : (
                    <div class="showcase-fallback" aria-hidden="true"></div>
                  )}
                  <div class="showcase-overlay">
                    <p class="story-meta">{movieLabel}</p>
                    <h3><a href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>{post.title}</a></h3>
                    <p>{post.excerpt}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {guestLabel && (
          <section class="home-section guest-writes" aria-labelledby="guest-writes-title">
            <div class="section-heading">
              <div>
                <h2 id="guest-writes-title">Guest author writes</h2>
              </div>
              <a class="archive-link" href={import.meta.env.BASE_URL + "archive/?tag=" + encodeURIComponent(guestLabel)}>More →</a>
            </div>
            <div class="guest-card-grid">
              {postsByLabel(guestLabel).slice(0, 3).map((post) => (
                <article class="guest-card">
                  {getPostImage(post) ? (
                    <a class="guest-card-image" href={import.meta.env.BASE_URL + getPostPath(post) + "/"} aria-label={"Read " + post.title}>
                      <img src={getPostImage(post)} alt="" loading="lazy" />
                    </a>
                  ) : <div class="guest-card-image guest-card-fallback" aria-hidden="true"></div>}
                  <div class="guest-card-body">
                    <p class="story-meta">{guestLabel}</p>
                    <h3><a href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>{post.title}</a></h3>
                    <p>{post.excerpt}</p>
                    <a class="guest-card-link" href={import.meta.env.BASE_URL + getPostPath(post) + "/"}>Read article →</a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

      </section>
    )}

    <section class="container author-note">
      <div>
        <p class="eyebrow">এপিটাফ · Epitaph</p>
        <h2>A home for words, ideas and things worth remembering.</h2>
      </div>
      <p>Writings by Prankrishna Borgohain, published from Blogger and gathered here in a quieter reading space.</p>
    </section>
  </main>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-label-tab]"));
    const tabScroller = document.querySelector<HTMLElement>(".label-tabs");
    const scrollButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-label-scroll]"));
    const setActiveTab = (index: number) => {
      const target = tabs[index];
      if (!target) return;
      target.click();
      target.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    };
    scrollButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const activeIndex = tabs.findIndex((tab) => tab.classList.contains("active"));
        const direction = Number(button.dataset.labelScroll || 0);
        const nextIndex = Math.max(0, Math.min(tabs.length - 1, activeIndex + direction));
        setActiveTab(nextIndex);
      });
    });
    if (tabScroller) {
      tabScroller.addEventListener("scroll", () => {
        const active = tabs.find((tab) => tab.classList.contains("active"));
        active?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
      }, { passive: true });
    }
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-label-panel]"));

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const label = tab.dataset.labelTab;
        tabs.forEach((item) => {
          const selected = item === tab;
          item.classList.toggle("active", selected);
          item.setAttribute("aria-selected", String(selected));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.labelPanel === label;
          panel.classList.toggle("active", active);
          panel.hidden = !active;
        });
      });
    });
  </script>
</BaseLayout>
