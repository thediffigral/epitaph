---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allPosts, getPost } from "../../lib/content";
export function getStaticPaths() {
  return allPosts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previous: allPosts[index + 1],
      next: allPosts[index - 1]
    }
  }));
}
const { post, previous, next } = Astro.props;
---
<BaseLayout title={post.title} description={post.excerpt}>
  <article class="page article-wrap">
    <p class="eyebrow">Epitaph</p>
    <h1 class="article-title">{post.title}</h1>
    <p class="meta">{new Date(post.published).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })} · {post.author}</p>
    <div class="tags">{post.labels.map((tag) => <span class="tag">{tag}</span>)}</div>
    <div class="article-content" set:html={post.content}></div>
    <nav class="article-nav" aria-label="Article navigation">
      {previous ? <a href={import.meta.env.BASE_URL + "post/" + previous.id + "/"}>← {previous.title}</a> : <span />}
      {next ? <a href={import.meta.env.BASE_URL + "post/" + next.id + "/"}>{next.title} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>