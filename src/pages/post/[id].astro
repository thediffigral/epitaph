---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allPosts, getPostPath } from "../../lib/content";

export function getStaticPaths() {
  return allPosts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previous: allPosts[index + 1],
      next: allPosts[index - 1]
    }
  }));
}

const { post, previous, next } = Astro.props;
const canonical = getPostPath(post);
---
<BaseLayout title={post.title + " — Epitaph"} description={post.excerpt} canonical={canonical}>
  <article class="page article-wrap">
    <h1 class="article-title">{post.title}</h1>
    <p class="article-author">{post.author}</p>
    <div class="tags">{post.labels.map((tag) => <a class="tag" href={import.meta.env.BASE_URL + "archive/?tag=" + encodeURIComponent(tag)}>{tag}</a>)}</div>
    <div class="article-content" set:html={post.content}></div>
    <div class="article-after">
      {post.updated !== post.published && <p class="updated-note">Updated on {new Date(post.updated).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</p>}
      {post.labels.length > 0 && (
        <section class="read-similar" aria-labelledby="read-similar-title">
          <h2 id="read-similar-title">Read similar</h2>
          <div class="tags">{post.labels.map((tag) => <a class="tag" href={import.meta.env.BASE_URL + "archive/?tag=" + encodeURIComponent(tag)}>{tag}</a>)}</div>
        </section>
      )}
    </div>
    <nav class="article-nav" aria-label="Article navigation">
      {previous ? <a href={import.meta.env.BASE_URL + getPostPath(previous) + "/"}>← {previous.title}</a> : <span />}
      {next ? <a href={import.meta.env.BASE_URL + getPostPath(next) + "/"}>{next.title} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
